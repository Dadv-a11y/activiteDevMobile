<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:CalculateurAge"
             x:Class="CalculateurAge.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Thème clair : fond blanc, boutons lavande pâle -->
            <Style TargetType="Page" ApplyToDerivedTypes="True">
                <Setter Property="BackgroundColor" Value="#FFFFFF" />
            </Style>
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="#2B2D42" />
            </Style>
            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="#2B2D42" />
                <Setter Property="PlaceholderColor" Value="#9AA0B4" />
                <Setter Property="BackgroundColor" Value="#F5F6FA" />
            </Style>
            <Style TargetType="DatePicker">
                <Setter Property="TextColor" Value="#2B2D42" />
                <Setter Property="BackgroundColor" Value="#F5F6FA" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="TextColor" Value="#3B3F8C" />
                <Setter Property="BackgroundColor" Value="#E6E8FA" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
